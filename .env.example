# ==============================================================================
# 10 Cent Agency — Environment Configuration Template (.env.example)
#
# Safe template containing placeholder values only.
# Never commit real secret keys, service role tokens, or private credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# App & Deployment Configuration
# ------------------------------------------------------------------------------
# Canonical public site URL (used for metadata, JSON-LD, and CSRF origin verification)
NEXT_PUBLIC_SITE_URL=https://www.10centagency.com
SITE_URL=https://www.10centagency.com

# Node environment (development | production | test)
NODE_ENV=development

# ------------------------------------------------------------------------------
# Reverse Proxy Trust Configuration
# ------------------------------------------------------------------------------
# Controls whether reverse proxy headers are trusted for client IP extraction.
# On Vercel (VERCEL=1), x-forwarded-for and x-real-ip are trusted automatically.
# TRUST_PROXY_HEADERS: Blanket trust for all upstream proxy headers (e.g. behind AWS ALB / Cloudflare).
# TRUST_CLOUDFLARE_PROXY: Set to 'true' if requests pass through Cloudflare (trusts cf-connecting-ip).
# TRUST_REVERSE_PROXY: Set to 'true' if requests pass through a reverse proxy like Nginx (trusts x-real-ip).
# When unset/false on direct origin, all proxy headers are rejected to prevent IP spoofing.
TRUST_PROXY_HEADERS=false
TRUST_CLOUDFLARE_PROXY=false
TRUST_REVERSE_PROXY=false

# ------------------------------------------------------------------------------
# Cloudflare Turnstile Anti-Bot Security
# ------------------------------------------------------------------------------
# Canonical browser-safe site key (displayed in Turnstile widget)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
# Legacy alias preserved for backward compatibility
NEXT_PUBLIC_CLOUDFLARE_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Server-only Turnstile secret key (used for server-side siteverify call)
# In production, missing secret fails closed. Never expose to client!
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# Legacy alias preserved for backward compatibility
CLOUDFLARE_TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Test automation bypass flag (ACTIVE ONLY when NODE_ENV !== 'production')
# Fails closed if enabled in production environments.
TURNSTILE_BYPASS_FOR_TESTS=false

# ------------------------------------------------------------------------------
# Distributed Rate Limiting (Tier 1: Upstash Redis REST)
# ------------------------------------------------------------------------------
# Upstash REST URL and bearer token for atomic distributed rate limiting.
# If unconfigured, falls back to Tier 2 (Supabase RPC check_rate_limit) or fails closed in production.
UPSTASH_REDIS_REST_URL=https://example-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=example-upstash-rest-token

# ------------------------------------------------------------------------------
# Supabase Configuration (Tier 2 Rate Limiting, Storage, Admin Operations)
# ------------------------------------------------------------------------------
# Public Supabase project URL (client and server)
NEXT_PUBLIC_SUPABASE_URL=https://example-project.supabase.co

# Public anonymous key (client-safe for public queries and auth initialization)
NEXT_PUBLIC_SUPABASE_ANON_KEY=example-anon-key-placeholder

# Privileged service role key (SERVER ONLY! Zero client write architecture)
# Used for server-side contact persistence, rate-limit RPC, and admin operations.
SUPABASE_SERVICE_ROLE_KEY=example-service-role-key-placeholder

# ------------------------------------------------------------------------------
# Analytics, Advertising & Google Consent Mode v2
# ------------------------------------------------------------------------------
# Google Tag Manager Container ID (e.g. GTM-XXXXXXX).
# If omitted or empty, GTM is not loaded (zero hardcoded fallback IDs).
NEXT_PUBLIC_GOOGLE_TAG_MANAGER_ID=GTM-XXXXXXX

# Google Analytics 4 Measurement ID (optional direct tag or GTM destination)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Meta (Facebook) Pixel ID for web and Conversions API tracking
# Requires marketing consent under Consent Mode v2 before firing.
NEXT_PUBLIC_META_PIXEL_ID=000000000000000

# ------------------------------------------------------------------------------
# Administration & Notifications
# ------------------------------------------------------------------------------
# Administrator email addresses (comma-separated list for notification delivery)
ADMIN_EMAILS=admin@10centagency.com
